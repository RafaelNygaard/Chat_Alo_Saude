# Copie para .env e ajuste os valores
DATABASE_URL=postgresql+psycopg2://alosaude:senha@localhost:5432/alosaude
SECRET_KEY=troque-esta-chave

# Rede: 127.0.0.1 = só local; 0.0.0.0 = todas as interfaces (acesso pela rede).
# Ao expor na rede, defina DEBUG=0 e use SECRET_KEY forte.
HOST=127.0.0.1
PORT=5000
DEBUG=1

# Gatilhos de handoff (Decisão B do ADR-001)
HANDOFF_LIMIAR_CONFIANCA=0.6
HANDOFF_MSGS_CONSECUTIVAS=2
HANDOFF_PRAZO_SEM_ATENDENTE_MIN=30

# SMTP de fallback (o principal é configurado na área administrativa).
# Sem SMTP algum, a senha temporária de recuperação vai para o log (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responder@alosaude.local
SMTP_TLS=1
